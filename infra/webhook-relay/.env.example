# Pin the published relay image to a sha256 digest before deploying.
WEBHOOK_RELAY_IMAGE=ghcr.io/gmod-integration/gmod-integration-webhook-relay@sha256:ce6cd0b571f689cea130373e9ec4559464c5684809bc5853b50cc1f42349749d
# Must match BARER_DISCORD_RELAY on the calling API.
BARER_TOKEN=
# Cloudflare Tunnel on this host forwards to http://127.0.0.1:3000.
WEBHOOK_RELAY_PORT=3000
