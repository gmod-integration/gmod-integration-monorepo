# Builds the .env pushed to /opt/gmod-integration/.env in the container. It is both the Compose
# interpolation file (API_HOST, *_REPLICAS, …) and the env_file of every app service.
#
# Precedence, lowest to highest:
#   generated credentials  <  var.env_file  <  var.app_env  <  deployment keys from Terraform variables

resource "random_password" "maria" {
  length  = 32
  special = false
}

resource "random_password" "maria_root" {
  length  = 32
  special = false
}

resource "random_password" "minio_access_key" {
  length  = 20
  special = false
}

resource "random_password" "minio_secret_key" {
  length  = 40
  special = false
}

locals {
  generated_env = {
    DEV                 = "false"
    DOMAIN_URL          = "https://${var.api_host}"
    MARIA_USER          = "gmod"
    MARIA_NAME          = "gmod_integration"
    MARIA_PASSWORD      = random_password.maria.result
    MARIA_ROOT_PASSWORD = random_password.maria_root.result
    MINIO_REGION        = "us-east-1"
    MINIO_ACCESS_KEY    = random_password.minio_access_key.result
    MINIO_SECRET_KEY    = random_password.minio_secret_key.result
  }

  # KEY=value lines of var.env_file. Values are kept raw (quotes, inline comments) so Compose parses them
  # exactly as it would have parsed the original file. Last occurrence wins, like dotenv.
  env_file_entries = [
    for line in split("\n", replace(var.env_file == null ? "" : sensitive(file(var.env_file)), "\r", "")) :
    regex("^\\s*(?:export\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(.*?)\\s*$", line)
    if can(regex("^\\s*(?:export\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*=", line))
  ]
  env_file_vars = { for k, vs in { for e in local.env_file_entries : e[0] => e[1]... } : k => vs[length(vs) - 1] }

  # Keys driven by Terraform variables: they always win over the .env file and app_env.
  deployment_env = {
    API_HOST           = var.api_host
    WS_HOST            = var.ws_host
    API_IMAGE          = "ghcr.io/gmod-integration/gmod-integration-api:${var.image_tag}"
    WEBSOCKET_IMAGE    = "ghcr.io/gmod-integration/gmod-integration-websocket:${var.image_tag}"
    DISCORD_IMAGE      = "ghcr.io/gmod-integration/gmod-integration-discord:${var.image_tag}"
    API_REPLICAS       = tostring(var.replicas.api)
    WEBSOCKET_REPLICAS = tostring(var.replicas.websocket)
    DISCORD_REPLICAS   = tostring(var.replicas.discord)
    COMPOSE_PROFILES   = var.cloudflare_tunnel_token == null ? "" : "tunnel"
  }

  env = merge(local.generated_env, local.env_file_vars, var.app_env, local.deployment_env)

  env_content = join("", concat(
    ["# Generated by Terraform (infra/proxmox/env.tf). Edit the Terraform inputs, not this file.\n"],
    [for k in sort(keys(local.env)) : "${k}=${local.env[k]}\n"],
  ))

  cloudflared_env = var.cloudflare_tunnel_token == null ? "# no tunnel configured\n" : "TUNNEL_TOKEN=${var.cloudflare_tunnel_token}\n"

  # What @gmod/config (packages/config/src/schema.ts) refuses to start without. MARIA_HOST and
  # MINIO_ENDPOINT are set by docker-stack.swarm.yml itself.
  required_env_keys = [
    "BARER_DISCORD_RELAY",
    "DISCORD_BOT_INVITE_URL",
    "DISCORD_BOT_TOKEN",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "DISCORD_GUILD_DISCORD_PREMIUM_ROLE_ID",
    "DISCORD_GUILD_GMODSTORE_PREMIUM_ROLE_ID",
    "DISCORD_GUILD_ID",
    "DISCORD_GUILD_PREMIUM_ROLE_ID",
    "DISCORD_SUBSCRIPTION_SKU_ID",
    "DOMAIN_URL",
    "GMODSTORE_API_KEY",
    "GMODSTORE_SECRET_WEBHOOK",
    "MARIA_NAME",
    "MARIA_PASSWORD",
    "MARIA_ROOT_PASSWORD",
    "MARIA_USER",
    "MINIO_ACCESS_KEY",
    "MINIO_REGION",
    "MINIO_SECRET_KEY",
    "OAUTH_PANEL_URL",
    "OAUTH_REDIRECT_URL",
    "SCREENSHOTS_CHANNEL_ID",
    "SIGNING_SECRET_WEBHOOK",
    "STEAM_API_KEY",
    "WEBSITE_URL",
  ]
  strong_secret_keys = ["MARIA_PASSWORD", "MARIA_ROOT_PASSWORD", "MINIO_SECRET_KEY"]

  # Validation runs on what the user supplied (known at plan time) — generated values are always present
  # and long enough. Only key names leave the sensitive context.
  env_supplied = merge(local.env_file_vars, var.app_env, local.deployment_env)
  env_supplied_value = {
    for k, v in local.env_supplied : k => trimspace(trim(v, "\"'"))
  }
  env_missing_keys = nonsensitive(sort([
    for k in local.required_env_keys : k
    if !contains(keys(local.generated_env), k) && lookup(local.env_supplied_value, k, "") == ""
  ]))
  env_placeholder_keys = nonsensitive(sort([
    for k, v in local.env_supplied_value : k if upper(v) == "SECRET"
  ]))
  env_weak_keys = nonsensitive(sort([
    for k in local.strong_secret_keys : k
    if contains(keys(local.env_supplied_value), k) && length(lookup(local.env_supplied_value, k, "")) < 17
  ]))
  # The MariaDB image creates MARIA_USER as a regular account next to root and refuses to start with
  # MARIADB_USER=root, which is what a local dev .env usually has.
  env_maria_user_is_root = nonsensitive(lower(lookup(local.env_supplied_value, "MARIA_USER", "")) == "root")
}
