{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@/discord": ["../../apps/discord/src/discord/index.ts"],
      "@/discord/*": ["../../apps/discord/src/discord/*"],
      "src/*": ["../../apps/api/src/*"],
      "@/*": ["../../apps/api/src/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}
