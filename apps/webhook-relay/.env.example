# apps/webhook-relay is standalone: it reads only these variables, never the repo-root .env.
# Bun loads ./.env automatically when started from this directory (`bun run dev`).

# Shared secret; must equal BARER_DISCORD_RELAY in the API's environment.
BARER_TOKEN=
# Optional, defaults to 3000 and 0.0.0.0.
APP_PORT=
APP_HOST=
