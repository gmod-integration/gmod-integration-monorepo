# Example merged crontab for Gmod Integration swarm maintenance.
# - Offsite encrypted backups via Plakar (see /home/ubuntu/plakar-backups)
# - Adds automatic image update/redeploy checker
#
# Install:
#   crontab -e
#   (paste lines below, adapted to your machine)
#
# NOTE: PROJECT_DIR must be a literal absolute path - crontab does not
# expand ${HOME} or other shell variables in its own assignments.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PROJECT_DIR=/home/ubuntu/gmod-integration-monorepo

# Every 15 minutes - git pull, then check images and deploy only on digest changes
*/15 * * * * cd "$PROJECT_DIR" && /usr/bin/flock -n /tmp/gmod-swarm-update.lock ./scripts/swarm-auto-update.sh >> "$PROJECT_DIR/logs/cron-update.log" 2>&1

# Plakar offsite backup (MariaDB, MongoDB, MinIO) to OVH S3 kloset @gmi-prod - daily at 03:15
15 3 * * * /home/ubuntu/plakar-backups/backup-gmi.sh >> /home/ubuntu/plakar-backups/logs/cron.log 2>&1
