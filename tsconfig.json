{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./apps/api/src",
    "baseUrl": "./",
    "paths": {
      "@/discord": ["apps/discord/src/discord/index.ts"],
      "@/discord/*": ["apps/discord/src/discord/*"],
      "@/*": ["apps/api/src/*"],
      "src/*": ["apps/api/src/*"]
    },
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "resolveJsonModule": true,

    "typeRoots": [
      "./node_modules/@types",
      "./packages/core/src/types"
    ],

    "types": [
      "node",
      "express"
    ],

    "sourceMap": true,
    "inlineSources": true,

    // Set `sourceRoot` to  "/" to strip the build path prefix
    // from generated source code references.
    // This improves issue grouping in Sentry.
    "sourceRoot": "/"
  },
  "include": [
    "apps/api/src/**/*",
    "packages/core/src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
