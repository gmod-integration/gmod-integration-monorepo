# Dummy-but-schema-valid values for @gmod/config, used only by the Vitest test suite.
# Loaded via CONFIG_ENV_FILE in test/setup.ts — NOT used by dev/prod (see .env / .env.example for those).
# No real secrets here; do not put real credentials in this file, it is committed to the repo.

DEV=true

MARIA_HOST=127.0.0.1
MARIA_USER=test
MARIA_PASSWORD=test-maria-password-not-a-real-secret
MARIA_NAME=gmod_test
MARIA_ROOT_PASSWORD=test-maria-root-password-not-a-real-secret

SCREENSHOTS_CHANNEL_ID=000000000000000000

WEBSITE_URL=http://localhost:3000
DOMAIN_URL=http://localhost:53136

DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=test-discord-client-secret-not-real
DISCORD_GUILD_ID=000000000000000000
DISCORD_BOT_TOKEN=test-discord-bot-token-not-a-real-secret
DISCORD_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=test

OAUTH_PANEL_URL=http://localhost:3000/oauth
OAUTH_REDIRECT_URL=http://localhost:3000/oauth/callback
BARER_DISCORD_RELAY=test-barer-discord-relay-not-a-real-secret

DISCORD_GUILD_PREMIUM_ROLE_ID=000000000000000000
DISCORD_GUILD_GMODSTORE_PREMIUM_ROLE_ID=000000000000000000
DISCORD_GUILD_DISCORD_PREMIUM_ROLE_ID=000000000000000000
DISCORD_SUBSCRIPTION_SKU_ID=000000000000000000

STEAM_API_KEY=test-steam-api-key-not-a-real-secret

GMODSTORE_API_KEY=test-gmodstore-api-key-not-a-real-secret
SIGNING_SECRET_WEBHOOK=test-signing-secret-webhook-not-real
GMODSTORE_SECRET_WEBHOOK=test-gmodstore-secret-webhook-not-real

MINIO_ENDPOINT=http://127.0.0.1:9060
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=test-minio-access-key
MINIO_SECRET_KEY=test-minio-secret-key-not-a-real-secret
