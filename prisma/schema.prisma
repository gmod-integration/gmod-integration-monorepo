model gm_server_stat {
  steam_id          String        @db.Char(30)
  server_id         String        @db.Char(255)
  name              String        @default("") @db.VarChar(255)
  rank              String        @default("user") @db.VarChar(255)
  total_time        Int           @default(0)
  total_death       Int           @default(0)
  total_kill        Int           @default(0)
  total_money       Int           @default(0)
  total_connect     Int           @default(1)
  last_connect      DateTime      @updatedAt
  first_join        DateTime      @default(now())
  custom_values     Json          @default("[]")
  bypassMaintenance Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  gm_server         gm_server     @relation(fields: [server_id], references: [id], onDelete: Cascade, map: "gm_server_stat_gm_server_id_fk")
  gm_user_steam     gm_user_steam @relation(fields: [steam_id], references: [steam_id], onDelete: Cascade, map: "gm_server_stat_gm_user_steam_steam_id_fk")

  @@id([server_id, steam_id])
  @@index([steam_id], map: "gm_server_stat_gm_user_steam_steam_id_fk")
}

model gm_server_stat_team_time {
  id        Int       @id @default(autoincrement())
  serverID  String    @db.VarChar(255)
  steamID64 String    @db.VarChar(255)
  team      String    @default("") @db.VarChar(255)
  teamID    Int       @default(0)
