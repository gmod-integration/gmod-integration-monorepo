generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model banUsers {
  id        Int      @id @default(autoincrement())
  steamID64 String   @default("") @db.VarChar(255)
  ip        String   @default("") @db.VarChar(255)
  discordID String   @default("") @db.VarChar(255)
  reason    String   @default("") @db.VarChar(255)
  banDate   DateTime @default(now())
  banTime   Int      @default(0)
  unbanDate DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL 2 YEAR)"))
  admin     String   @default("") @db.VarChar(255)
  name      String   @default("") @db.VarChar(255)
  permanent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model gm_discordToken {
  discordID      String   @id @db.Char(255)
  accessToken    String   @db.VarChar(255)
  refreshToken   String   @db.VarChar(255)
  creationDate   DateTime @default(now())
  expirationDate DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL 7 DAY)"))
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model gm_gmodstore_purchases {
  steamID64 String   @id @db.VarChar(255)
  userID    String   @default("") @db.VarChar(255)
  guild     String   @default("") @db.VarChar(255)
  token     String   @default("") @db.VarChar(255)
  revoke    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model gm_guild {
  guild                       String                        @id @db.Char(255)
  name                        String                        @default("") @db.VarChar(255)
  member                      Int                           @default(0)
  language                    String                        @default("en") @db.VarChar(255)
  addDate                     DateTime?                     @default(now()) @db.Timestamp(0)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  gm_guild_auto_roles         gm_guild_auto_roles[]
  gm_guild_verify_msg         gm_guild_verify_msg?
  gm_guild_verify_role        gm_guild_verify_role[]
  gm_server                   gm_server[]
  gm_server_links             gm_server_links[]
  gm_sync_chat                gm_sync_chat[]
  gm_guild_verification_check gm_guild_verification_check[]
  gm_guild_webooks            gm_guild_webooks[]
}

model gm_guild_auto_roles {
  guildID   String   @db.VarChar(255)
  roleID    String   @id @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gm_guild  gm_guild @relation(fields: [guildID], references: [guild], onDelete: Cascade, map: "gm_guild_auto_roles_ibfk_1")

  @@index([guildID], map: "guildID")
}

model gm_guild_member {
  guild_id String    @db.Char(255)
  user_id  String    @db.Char(255)
  date     DateTime? @default(now()) @db.Timestamp(0)

  @@id([guild_id, user_id])
}

model gm_guild_premium {
  guildID     String   @id @db.VarChar(255)
  transaction String?  @db.Text
  buyer       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model gm_guild_settings {
  guildID   String   @db.Char(255)
  setting   String   @db.Char(255)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([guildID, setting])
}

model gm_guild_verify_msg {
  guildID   String   @id @db.VarChar(255)
  messageID String   @db.VarChar(255)
  channelID String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gm_guild  gm_guild @relation(fields: [guildID], references: [guild], onDelete: Cascade, map: "gm_guild_verify_msg_ibfk_1")
}

model gm_guild_verify_role {
  id         Int      @id @default(autoincrement())
  guildID    String   @db.VarChar(255)
  roleID     String   @db.VarChar(255)
  isGiveRole Boolean  @default(true)
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  gm_guild   gm_guild @relation(fields: [guildID], references: [guild], onDelete: Cascade, map: "gm_guild_verify_role_ibfk_1")

  @@index([guildID], map: "guildID")
}

model gm_panelToken {
  id             String   @id @db.Char(36)
  discordID      String   @db.VarChar(255)
  accessToken    String   @db.VarChar(255)
  os             String?  @db.VarChar(255)
  ip             String?  @db.VarChar(255)
  country        String?  @db.VarChar(255)
  browser        String?  @db.VarChar(255)
  revoke         Boolean  @default(false)
  creationDate   DateTime @default(now())
  expirationDate DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL 7 DAY)"))
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model gm_role_auto {
  guild     String   @db.Char(255)
  id        String   @db.VarChar(255)
  channel   String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([guild, id])
}

model gm_server {
  id                            String                          @id @db.Char(255)
  token                         String                          @db.VarChar(255)
  publicTempToken               String?                         @default("") @db.VarChar(255)
  guild                         String                          @db.Char(255)
  ip                            String?                         @default("127.0.0.1") @db.VarChar(255)
  port                          String?                         @default("27015") @db.VarChar(255)
  name                          String?                         @default("New Gmod Server") @db.VarChar(255)
  image                         String?                         @default("") @db.VarChar(255)
  verified                      Boolean                         @default(false)
  bump                          Int                             @default(0)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  description                   String?                         @default("") @db.VarChar(255)
  isPublic                      Boolean                         @default(false)
  gm_guild                      gm_guild                        @relation(fields: [guild], references: [guild], onDelete: Cascade, map: "gm_server_ibfk_1")
  gm_server_errors              gm_server_errors[]
  gm_server_leaderboard_options gm_server_leaderboard_options[]
  gm_server_logs_channel        gm_server_logs_channel?
  gm_server_pseudo              gm_server_pseudo[]
  gm_server_report_bugs         gm_server_report_bugs[]
  gm_server_roles               gm_server_roles[]
  gm_server_screenshot_channels gm_server_screenshot_channels[]
  gm_server_screenshots         gm_server_screenshots[]
  gm_server_settings            gm_server_settings[]
  gm_server_stat                gm_server_stat[]
  gm_server_stat_session        gm_server_stat_session[]
  gm_server_status              gm_server_status?
  gm_server_sync_chat_filter    gm_server_sync_chat_filter[]
  gm_server_sync_roles          gm_server_sync_roles[]
  gm_server_sync_team_roles     gm_server_sync_team_roles[]
  gm_server_vote                gm_server_vote[]
  gm_server_vote_channels       gm_server_vote_channels?
  gm_server_warn                gm_server_warn[]
  gm_server_ban                 gm_server_ban[]
  gm_server_warn_options        gm_server_warn_options[]
  gm_status                     gm_status?
  gm_status_button              gm_status_button[]
  gm_sync_chat                  gm_sync_chat[]
  gm_server_status_history      gm_server_status_history[]
  gm_server_stat_team_time      gm_server_stat_team_time[]
  gm_server_logs_triggers       gm_server_logs_triggers[]

  @@index([guild], map: "guild")
}

model gm_server_customValues {
  serverID  String?  @db.Char(255)
  value     String?  @db.Char(255)
  enable    Boolean? @default(false)
  valueName String   @id @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model gm_server_errors {
  id         Int       @id @default(autoincrement())
  serverID   String    @db.VarChar(255)
  count      Int
  realm      String    @db.VarChar(255)
  error      String    @db.Text
  stack      String    @db.Text
  name       String    @db.VarChar(255)
  steamID64  String    @default("") @db.VarChar(255)
  workshopID String    @default("") @db.VarChar(255)
  uptime     Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  gm_server  gm_server @relation(fields: [serverID], references: [id], onDelete: Cascade, map: "gm_server_errors_ibfk_1")

  @@index([serverID], map: "serverID")
}

model gm_server_leaderboard_options {
  serverID     String    @db.Char(17)
  messageID    String    @db.Char(255)
  category     String    @default("") @db.VarChar(255)
  limitValue   Int       @default(10)
  offsetValue  Int       @default(0)
  orderValue   String    @default("DESC") @db.VarChar(255)
  page         Int       @default(1)
  totalPages   Int?
  creationDate DateTime? @default(now())
  updateDate   DateTime? @updatedAt
  total        Int?
  totalPage    Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  gm_server    gm_server @relation(fields: [serverID], references: [id], onDelete: Cascade, map: "gm_server_leaderboard_options_gm_server_id_fk")

  @@id([messageID, serverID])
  @@index([serverID], map: "gm_server_leaderboard_options_gm_server_id_fk")
}

model gm_server_links {
  id        Int      @id @default(autoincrement())
  url       String   @default("https://example.com") @db.Text
  alias     String   @default("Example") @db.VarChar(255)
  guild     String   @db.VarChar(255)
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gm_guild  gm_guild @relation(fields: [guild], references: [guild], onDelete: Cascade, map: "gm_server_links_ibfk_1")

  @@index([guild], map: "guild")
}

model gm_server_logs {
  serverID                String?  @db.Char(255)
  type                    String   @db.VarChar(255)
  timeStamp               DateTime @default(now()) @db.Timestamp(0)
  id                      Int      @id @default(autoincrement())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  data                    Json     @default("[]")
  playerInvolvedSteamID64 Json     @default("[]")

  @@index([serverID], map: "gm_server_logs_gm_server_id_fk")
}

model gm_server_logs_channel {
  serverID     String    @id @db.VarChar(255)
  channelID    String    @db.VarChar(255)
  webhookID    String    @db.VarChar(255)
  webhookToken String    @db.VarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  gm_server    gm_server @relation(fields: [serverID], references: [id], onDelete: Cascade, map: "gm_server_logs_channel_ibfk_1")
}

model gm_server_pseudo {
  id        Int       @id @default(autoincrement())
  serverID  String    @db.VarChar(255)
  role      String    @default("") @db.VarChar(255)
  name      String    @default("") @db.VarChar(255)
  prefix    String    @default("") @db.VarChar(255)
  enabled   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  gm_server gm_server @relation(fields: [serverID], references: [id], onDelete: Cascade, map: "gm_server_pseudo_ibfk_1")

  @@index([serverID], map: "serverID")
}

model gm_server_report_bugs {
  id          Int                              @id @default(autoincrement())
  serverID    String                           @db.VarChar(255)
  steamID64   String                           @db.VarChar(255)
  description String                           @db.Text
  status      gm_server_report_bugs_status     @default(open)
  steps       String                           @db.Text
  expected    String                           @db.Text
  actual      String                           @db.Text
  importance  gm_server_report_bugs_importance @default(low)
  screenshot  String                           @default("") @db.VarChar(255)
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
  gm_server   gm_server                        @relation(fields: [serverID], references: [id], onDelete: Cascade, map: "gm_server_report_bugs_ibfk_1")

  @@index([serverID], map: "serverID")
}

model gm_server_roles {
  id            Int        @id @default(autoincrement())
  serverID      String?    @db.Char(17)
  role          String?    @db.VarChar(255)
  roleName      String?    @default("") @db.Text
  prefix        String?    @default("") @db.Text
