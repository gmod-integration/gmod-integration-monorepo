  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  gm_server gm_server @relation(fields: [serverID], references: [id], onDelete: Cascade)

  @@index([serverID], map: "serverID")
}

model gm_server_stat_session {
  serverID            String?        @db.Char(255)
  steamID64           String?        @db.Char(255)
  time                Int            @default(0)
  deaths              Int            @default(0)
  kills               Int            @default(0)
  customValues        Json?          @default("[]")
  sessionEndTimeStamp DateTime       @default(now()) @db.Timestamp(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  id                  Int            @id @default(autoincrement())
  gm_server           gm_server?     @relation(fields: [serverID], references: [id], onDelete: Cascade, map: "gm_server_stat_session_ibfk_125")
  gm_user_steam       gm_user_steam? @relation(fields: [steamID64], references: [steam_id], onDelete: Cascade, map: "gm_server_stat_session_ibfk_126")

  @@index([serverID], map: "gm_server_stat_session_1_gm_user_steam_steam_id_fk")
  @@index([steamID64], map: "gm_server_stat_session_gm_user_steam_steam_id_fk")
}

