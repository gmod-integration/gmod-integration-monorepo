{
  "name": "api",
  "version": "2.0.0",
  "description": "",
  "main": "dist/gm_integration_api.js",
  "scripts": {
    "js:start": "pm2 start src/gm_integration_api.ts --log logs/current.log --name gmod-integration-api",
    "js:dev": "node --watch --trace-warnings --trace-deprecation .",
    "discord:push:context": "tsx src/discord/discord_push_context.ts",
    "discord:remove:cmd": "tsx --watch --trace-warnings --trace-deprecation src/discord/discord_remove_cmd.ts",
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsc && npm run sentry:sourcemaps",
    "dev": "tsx watch src/gm_integration_api.ts --env dev",
    "start": "pm2 start ./dist/gm_integration_api.js --log logs/current.log --name gmod-integration-api",
    "reload": "pm2 reload gmod-integration-api --update-env",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migration:create": "npx prisma migrate dev --create-only",
    "prisma:migrate:prod": "npx prisma migrate deploy",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org gmod-integration --project node-express ./dist && sentry-cli sourcemaps upload --org gmod-integration --project node-express ./dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmod-integration/api.git"
  },
  "type": "module",
  "author": "Linventif",
  "license": "Proprietary",
  "bugs": {
    "url": "https://github.com/gmod-integration/api/issues"
  },
  "homepage": "https://github.com/gmod-integration/api#readme",
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-useragent": "^1.0.5",
    "@types/json-bigint": "^1.0.4",
    "@types/mongodb": "^4.0.6",
    "@types/node-cron": "^3.0.11",
    "@types/steamapi": "^2.2.5",
    "@types/uuid": "^10.0.0",
    "prettier": "^3.2.5",
    "prisma": "^6.8.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.828.0",
    "@discordjs/builders": "^1.9.0",
    "@prisma/client": "^6.5.0",
    "@sentry/cli": "^2.41.1",
    "@sentry/core": "^8.7.0",
    "@sentry/node": "^8.51.0",
    "@sentry/profiling-node": "^8.51.0",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.7.6",
    "archiver": "^7.0.1",
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "discord-api-types": "^0.37.103",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-useragent": "^1.0.15",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsdom": "^25.0.1",
    "json-bigint": "^1.0.0",
    "mariadb": "^3.3.0",
    "moment": "^2.30.1",
    "mongodb": "^6.10.0",
    "mysql2": "^3.6.3",
    "node-cron": "^3.0.3",
    "pm2": "^5.3.1",
    "redis": "^4.7.0",
    "sequelize": "^6.37.3",
    "sharp": "^0.33.5",
    "steamapi": "^2.4.2",
    "unicode-emoji": "^2.5.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "zod": "^3.24.4",
    "zod-openapi": "^4.2.4"
  }
}
