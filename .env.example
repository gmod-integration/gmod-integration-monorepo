###############################
# README
###############################
# This file serves as an example environment configuration for the GMod Integration API.
# Copy this file to .env and fill in the appropriate values for your environment.
# Default values are provided for local development, but should be changed for production use.
# Never use prod credentials in dev environment and vice versa.
# Always keep your credentials secure and do not commit them to version control.

###############################
# General
###############################
# Public API URL for the api, used for gmod server & website to communicate with the api.
DOMAIN_URL=http://localhost:53136
# Public URL for the website, used for redirects and links to the website.
WEBSITE_URL=http://localhost:3000
# Public WebSocket URL for the website, used for real-time communication between the client and server.
WEBSITE_WS_URL=ws://localhost:53139
# Traefik host rule used by the Swarm stack to route API traffic.
API_HOST=api.localhost
# Traefik host rule used by the Swarm stack to route WebSocket traffic.
WS_HOST=ws.localhost
# Traefik host rule used to expose the Traefik dashboard.
TRAEFIK_DASHBOARD_HOST=traefik.localhost
# Show missing translations in the website (only relevant if DEV is true)
WEBSITE_DEV_SHOW_MISSING_TRANSLATIONS=false
# Enable development mode
DEV=false

###############################
# MariaDB
###############################
# Connection URL for the database, used by the application to connect to the database. Format: mysql://user:password@host:port/database
MARIA_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
# Host where the database is running, typically localhost or an IP address.
MARIA_HOST=127.0.0.1
# Port on which the database is listening, default for MySQL/MariaDB is 3306.
MARIA_PORT=3306
# Username for authenticating with the database, default is root for local development.
MARIA_USER=SECRET
# Name of the database to connect to, should be created beforehand.
MARIA_NAME=SECRET
# Password for authenticating with the database, default is root for local development.
MARIA_PASSWORD=SECRET
# Maximum number of connections in the database connection pool.
# In local dev, multiple turbo processes can run at once, so keep this low.
MARIA_CONNECTION_LIMIT=10
# Root password for the database, used for administrative tasks.
MARIA_ROOT_PASSWORD=SECRET

###############################
# MinIO / S3
###############################
# Endpoint URL for the MinIO server
MINIO_ENDPOINT=http://localhost:9060
# AWS region, not relevant for MinIO but required for S3 compatibility
MINIO_REGION=us-east-1
# Access key for MinIO (equivalent to AWS Access Key)
MINIO_ACCESS_KEY=SECRET
# Secret key for MinIO (equivalent to AWS Secret Key)
MINIO_SECRET_KEY=SECRET

###############################
# Discord
###############################
# Guild ID of the official GMod Integration Discord server.
DISCORD_GUILD_ID=SECRET
# The discord channel ID in the admin Guild where screenshots will be posted for discord caching to avoid embed issues.
SCREENSHOTS_CHANNEL_ID=SECRET
# Client ID for the Discord application, used for OAuth2 authentication and API interactions.
DISCORD_CLIENT_ID=SECRET
# Client Secret for the Discord application, used for OAuth2 authentication and API interactions.
DISCORD_CLIENT_SECRET=SECRET
# URL for the OAuth panel, used in the Discord Login flow
OAUTH_PANEL_URL=SECRET
# Redirect URL for OAuth, used in the Discord Login flow
OAUTH_REDIRECT_URL=SECRET
# Bot Token for the Discord bot, used to authenticate the bot and allow it to perform actions in the Discord server.
DISCORD_BOT_TOKEN=SECRET
# Invite URL for the Discord bot
DISCORD_BOT_INVITE_URL=SECRET
# ID of the role given to users who have subscribed or bought on GModStore.
DISCORD_GUILD_PREMIUM_ROLE_ID=SECRET
# ID of the role given to users who have bought Gmod Integration on the GmodStore
DISCORD_GUILD_GMODSTORE_PREMIUM_ROLE_ID=SECRET
# ID of the role given to users who have subscribed to the Discord subscription.
DISCORD_GUILD_DISCORD_PREMIUM_ROLE_ID=SECRET
# SKU ID for the Discord subscription, used to give users Premium & Discord Premium roles on Admin Guild
DISCORD_SUBSCRIPTION_SKU_ID=SECRET

###############################
# GModStore
###############################
# Secret used to verify the authenticity of incoming webhook requests from GModStore.
SIGNING_SECRET_WEBHOOK=SECRET
# API key for GModStore, used to authenticate API requests and access GModStore data.
GMODSTORE_API_KEY=SECRET
# Secret used to verify the authenticity of incoming webhook requests from GModStore related to subscription events.
GMODSTORE_SECRET_WEBHOOK=SECRET

###############################
# Sentry Monitoring
###############################
# DSN (Data Source Name) for Sentry, used to identify the project and send error reports
SENTRY_DSN=SECRET
# Authentication token for Sentry, required for certain API operations and integrations
SENTRY_AUTH_TOKEN=SECRET

###############################
# Discord Webhook Relay Server
###############################
# Auth Token to authenticate the api
BARER_DISCORD_RELAY=SECRET

###############################
# Steam
###############################
# API key for Steam, used to access Steam's Web API for retrieving user information, game details, and other Steam-related data.
STEAM_API_KEY=SECRET
